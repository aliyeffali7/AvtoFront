{
  "headers": [
    { "source": "/s/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://auto2.era-con.az/api/$1" },
    { "source": "/media/(.*)", "destination": "https://auto2.era-con.az/media/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
